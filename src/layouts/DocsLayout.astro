---
import SiteLayout from "./SiteLayout.astro";
interface Props { title: string; description: string; heading: string; eyebrow: string; }
const { title, description } = Astro.props;
---
<SiteLayout title={title} description={description} noindex>
  <section class="section shell article-content" style="min-height:60vh;padding-top:clamp(70px,12vw,140px)">
    <h1>Documentation is not available yet.</h1>
    <p class="content-copy">Aurora is still in development and has no public release. User and developer documentation will be published when there is a release to document.</p>
    <p><a class="text-link" href="/en/ecosystem/">Explore the Aurora ecosystem ↗</a></p>
  </section>
</SiteLayout>