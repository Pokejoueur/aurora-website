---
import "../styles/global.css";
import "../styles/content-layout.css";
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const navigation = [
  { label: "Products", href: "/en/ecosystem/" },
  { label: "Documentation", href: "/en/docs/" },
  { label: "Downloads", href: "/en/downloads/" },
  { label: "Status", href: "/en/development/" },
  { label: "About", href: "/en/about/" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#03080c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Aurora" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header reference-header">
      <div class="shell header-inner">
        <a class="brand" href="/en/" aria-label="Aurora home">
          <img class="brand-mark" src="/aurora-mark.svg" alt="" width="44" height="44" />
          <span class="brand-name">AURORA</span>
        </a>
        <button class="mobile-menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label="Open navigation">
          <span class="mobile-menu-label">Menu</span>
          <span class="mobile-menu-icon" aria-hidden="true"><i></i><i></i></span>
        </button>
        <nav class="main-nav" id="primary-navigation" aria-label="Main navigation">
          {navigation.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href || (item.href !== "/en/ecosystem/" && Astro.url.pathname.startsWith(item.href)) ? "page" : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="reference-footer">
      <div class="shell reference-footer-inner">
        <a class="brand footer-brand" href="/en/" aria-label="Aurora home">
          <img class="brand-mark" src="/aurora-mark.svg" alt="" width="34" height="34" />
          <span class="brand-name">AURORA</span>
        </a>
        <p>Independent computing. Built deliberately.</p>
        <div class="footer-link-groups">
          <div><span>ECOSYSTEM</span><a href="/en/ecosystem/os/">Aurora OS</a><a href="/en/ecosystem/browser/">Lumen Browser</a><a href="/en/downloads/">Downloads</a></div>
          <div><span>FOR USERS</span><a href="/en/docs/">Documentation home</a><a href="/en/docs/getting-started/">Getting started</a><a href="/en/docs/faq/">FAQ and help</a></div>
          <div><span>FOR DEVELOPERS</span><a href="/en/docs/developer-guide/">Developer guide</a><a href="/en/engineering/architecture/">Architecture</a><a href="/en/community/contributing/">Contribute</a><a href="https://github.com/Pokejoueur/aurora-website" target="_blank" rel="noreferrer">Website source ↗</a></div>
          <div><span>PROJECT</span><a href="/en/about/">About Aurora</a><a href="/en/community/">Community</a><a href="/en/development/">Development status</a><a href="/en/legal/privacy/">Privacy</a><a href="/en/legal/accessibility/">Accessibility</a><a href="/en/legal/licenses/">Licenses</a></div>
        </div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Aurora Project</span><span>Public information · Evidence-led development</span><a href="/en/development/">Project status ↘</a></div>
    </footer>

    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>(".mobile-menu-toggle");
      const primaryNavigation = document.querySelector<HTMLElement>("#primary-navigation");

      if (menuToggle && primaryNavigation) {
        const closeMenu = (restoreFocus = false) => {
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", "Open navigation");
          primaryNavigation.removeAttribute("data-open");
          if (restoreFocus) menuToggle.focus();
        };

        menuToggle.addEventListener("click", () => {
          const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
          menuToggle.setAttribute("aria-expanded", String(!isOpen));
          menuToggle.setAttribute("aria-label", isOpen ? "Open navigation" : "Close navigation");
          if (isOpen) primaryNavigation.removeAttribute("data-open");
          else primaryNavigation.setAttribute("data-open", "true");
        });

        primaryNavigation.addEventListener("click", (event) => {
          if (event.target instanceof Element && event.target.closest("a")) closeMenu();
        });

        document.addEventListener("pointerdown", (event) => {
          if (event.target instanceof Node && !primaryNavigation.contains(event.target) && !menuToggle.contains(event.target)) closeMenu();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") closeMenu(true);
        });

        window.matchMedia("(min-width: 981px)").addEventListener("change", () => closeMenu());
      }
    </script>
    <style>
      .mobile-menu-toggle { display: none; }
      @media (max-width: 980px) {
        .reference-header .header-inner {
          position: relative;
          width: calc(100% - 40px);
          min-height: 70px;
          flex-wrap: nowrap;
          gap: 16px;
          padding-top: 0;
        }
        .reference-header .brand { min-width: 0; height: 54px; border: 0; padding: 0; }
        .reference-header .brand-mark { width: 36px; height: 36px; }
        .mobile-menu-toggle {
          display: inline-flex;
          min-width: 76px;
          min-height: 42px;
          align-items: center;
          justify-content: center;
          gap: 10px;
          padding: 0 10px;
          border: 1px solid var(--line);
          color: var(--text);
          background: transparent;
          font: 9px var(--mono);
          letter-spacing: .1em;
          text-transform: uppercase;
          cursor: pointer;
        }
        .mobile-menu-icon { display: grid; width: 14px; gap: 4px; }
        .mobile-menu-icon i { display: block; width: 14px; height: 1px; background: var(--accent); transition: transform .16s ease; }
        .mobile-menu-toggle[aria-expanded="true"] .mobile-menu-icon i:first-child { transform: translateY(2.5px) rotate(45deg); }
        .mobile-menu-toggle[aria-expanded="true"] .mobile-menu-icon i:last-child { transform: translateY(-2.5px) rotate(-45deg); }
        .reference-header .main-nav {
          position: absolute;
          top: calc(100% - 1px);
          right: 20px;
          z-index: 10;
          display: none;
          width: min(340px, calc(100vw - 40px));
          height: auto;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          margin: 0;
          padding: 8px 18px;
          border: 1px solid var(--line);
          background: #03080c;
          box-shadow: 0 18px 38px rgba(0, 0, 0, .32);
        }
        .reference-header .main-nav[data-open="true"] { display: flex; }
        .reference-header .main-nav a {
          display: flex;
          min-height: 48px;
          align-items: center;
          padding: 0 2px;
          border-bottom: 1px solid var(--line-soft);
          font-size: 10px;
        }
        .reference-header .main-nav a:last-child { border-bottom: 0; }
      }
      @media (max-width: 520px) {
        .reference-header .header-inner { width: calc(100% - 36px); }
        .reference-header .main-nav { right: 18px; width: calc(100vw - 36px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .mobile-menu-icon i { transition: none; }
      }
    </style>
  </body>
</html>
