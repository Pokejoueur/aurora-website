---
import "../styles/global.css";
import "../styles/content-layout.css";
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const navigation = [
  { label: "Ecosystem", href: "/en/ecosystem/" },
  { label: "Development", href: "/en/development/" },
  { label: "Availability", href: "/en/downloads/" },
  { label: "About", href: "/en/about/" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#050505" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Kryos" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/kryos-mark.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header reference-header">
      <div class="shell header-inner">
        <a class="brand" href="/en/" aria-label="Kryos home">
          <img class="brand-mark" src="/kryos-mark.svg" alt="" width="44" height="44" />
          <span class="brand-name">KRYOS</span>
        </a>
        <details class="mobile-menu">
          <summary aria-label="Open navigation"><span class="mobile-menu-label">Menu</span><span class="mobile-menu-icon" aria-hidden="true"><i></i><i></i></span></summary>
          <nav class="mobile-menu-panel" aria-label="Mobile navigation">
            {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
        </details>
        <nav class="main-nav" id="primary-navigation" aria-label="Main navigation">
          {navigation.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href || (item.href !== "/en/ecosystem/" && Astro.url.pathname.startsWith(item.href)) ? "page" : undefined}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="reference-footer">
      <div class="shell reference-footer-inner">
        <div class="footer-identity">
          <a class="brand footer-brand" href="/en/" aria-label="Kryos home">
            <img class="brand-mark" src="/kryos-mark.svg" alt="" width="34" height="34" />
            <span class="brand-name">KRYOS</span>
          </a>
          <p>Kryos is in development. Product availability is announced individually.</p>
        </div>
        <div class="footer-link-groups">
          <div><span>ECOSYSTEM</span><a href="/en/ecosystem/">Overview</a><a href="/en/ecosystem/os/">Kryos OS</a><a href="/en/ecosystem/browser/">Veckt Browser</a></div>
          <div><span>PROJECT</span><a href="/en/about/">About Kryos</a><a href="/en/development/">Development</a><a href="/en/community/">Community</a><a href="/en/downloads/">Release availability</a></div>
          <div><span>INFORMATION</span><a href="/en/legal/privacy/">Privacy</a><a href="/en/legal/accessibility/">Accessibility</a><a href="/en/legal/licenses/">Licenses</a></div>
        </div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Kryos Project</span><span>Independent computing ecosystem</span></div>
    </footer>
    <style>
      .mobile-menu { display:none; }
      @media (max-width:980px) {
        .reference-header .header-inner { position:relative; width:calc(100% - 40px); min-height:70px; flex-wrap:nowrap; gap:16px; padding-top:0; }
        .reference-header .brand { min-width:0; height:54px; border:0; padding:0; }
        .reference-header .brand-mark { width:36px; height:36px; }
        .mobile-menu { position:relative; display:block; margin-left:auto; }
        .mobile-menu summary { display:inline-flex; min-width:76px; min-height:42px; align-items:center; justify-content:center; gap:10px; padding:0 10px; border:1px solid var(--line); color:var(--text); background:transparent; font:9px var(--mono); letter-spacing:.1em; text-transform:uppercase; cursor:pointer; list-style:none; }
        .mobile-menu summary::-webkit-details-marker { display:none; }
        .mobile-menu-icon { display:grid; width:14px; gap:4px; }
        .mobile-menu-icon i { display:block; width:14px; height:1px; background:var(--accent); transition:transform .16s ease; }
        .mobile-menu[open] .mobile-menu-icon i:first-child { transform:translateY(2.5px) rotate(45deg); }
        .mobile-menu[open] .mobile-menu-icon i:last-child { transform:translateY(-2.5px) rotate(-45deg); }
        .mobile-menu-panel { position:absolute; top:calc(100% + 8px); right:0; z-index:20; display:flex; width:min(340px,calc(100vw - 40px)); flex-direction:column; padding:8px 18px; border:1px solid var(--line); background:#050505; box-shadow:0 18px 38px rgba(0,0,0,.32); }
        .mobile-menu-panel a { display:flex; min-height:48px; align-items:center; padding:0 2px; border-bottom:1px solid var(--line-soft); color:var(--text); font:10px var(--mono); text-decoration:none; }
        .mobile-menu-panel a:last-child { border-bottom:0; }
        .reference-header .main-nav { display:none !important; }
      }
      @media (min-width:981px) { .mobile-menu { display:none; } }
      @media (prefers-reduced-motion:reduce) { .mobile-menu-icon i { transition:none; } }
    </style>
  </body>
</html>