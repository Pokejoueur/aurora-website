---
import SiteLayout from "./SiteLayout.astro";
interface Props { title: string; description: string; eyebrow?: string; heading: string; lead: string; }
const { title, description, heading, lead } = Astro.props;
const isTechnicalDocumentation = Astro.url.pathname.startsWith("/en/engineering/");
const labels: Record<string, string> = {
  ecosystem: "Ecosystem", os: "Kryos OS", browser: "Veckt Browser", platform: "Kryos Platform",
  engineering: "Engineering", architecture: "Architecture", security: "Security", privacy: "Privacy",
  decisions: "Technical decisions", development: "Development", roadmap: "Roadmap", changelog: "Changelog",
  verification: "Verification", docs: "Documentation", "getting-started": "Getting started",
  "user-guide": "User guide", "developer-guide": "Developer guide", reference: "Reference", faq: "FAQ",
  community: "Community", contributing: "Contributing", feedback: "Feedback", downloads: "Availability",
  legal: "Legal", licenses: "Licenses", accessibility: "Accessibility", "add-ons": "Add-ons", extensions: "Extensions",
};
const segments = Astro.url.pathname.split("/").filter(Boolean).slice(1);
const crumbs = segments.map((segment, index) => ({
  label: labels[segment] ?? segment.replaceAll("-", " "),
  href: "/en/" + segments.slice(0, index + 1).join("/") + "/",
}));
---
<SiteLayout title={title} description={description} noindex={isTechnicalDocumentation}>
  {isTechnicalDocumentation ? (
    <section class="section shell article-content" style="min-height:60vh;padding-top:clamp(70px,12vw,140px)">
      <h1>Technical documentation is not available yet.</h1>
      <p class="content-copy">Kryos is still in development. Technical documentation will be published when there is a release to document.</p>
      <p><a class="text-link" href="/en/ecosystem/">Explore the Kryos ecosystem ↗</a></p>
    </section>
  ) : (
  <div class="content-page">
    <section class="content-hero shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/en/">Home</a>{crumbs.map((crumb, index) => <><span aria-hidden="true">/</span>{index === crumbs.length - 1 ? <span aria-current="page">{crumb.label}</span> : <a href={crumb.href}>{crumb.label}</a>}</>)}</nav>
      <h1>{heading}</h1>
      <p class="content-lead">{lead}</p>
    </section>
    <slot />
  </div>
  )}
</SiteLayout>