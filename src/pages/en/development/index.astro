---
import ContentLayout from "../../../layouts/ContentLayout.astro";
import status from "../../../data/status.json";
---
<ContentLayout title="Development" description="Aurora development status and verification information." eyebrow="DEVELOPMENT / STATUS" heading="Progress you can inspect." lead="Public progress records distinguish a working prototype from an implemented, tested or verified capability. Evidence and limitations remain visible.">
  <section class="section shell">
    <table class="status-table">
      <caption>Public development status — last reviewed {status.lastReviewed}</caption>
      <thead><tr><th scope="col">Workstream</th><th scope="col">Status</th><th scope="col">Limitations</th><th scope="col">Evidence</th></tr></thead>
      <tbody>
        {status.entries.map((entry) => <tr><th scope="row">{entry.name}</th><td><span class="status-label">{entry.status.toUpperCase()}</span></td><td>{entry.limitations}</td><td>{entry.evidence.map((url, index) => <a href={url} target="_blank" rel="noreferrer">Source {index + 1} ↗</a>)}</td></tr>)}
      </tbody>
    </table>
    <p class="evidence-note">This registry is static and repository-maintained; it is not a live GitHub synchronization service.</p>
    <p><a class="text-link" href="https://github.com/Pokejoueur/aurora-website/blob/main/docs/development/roadmap.md">Read the implementation roadmap ↗</a></p>
  </section>
  <section class="section shell status-definitions">
    <p class="eyebrow">STATUS DEFINITIONS</p>
    <h2>What each label means.</h2>
    <dl>
      <div><dt>PLANNED</dt><dd>Approved future work; no implementation is implied.</dd></div>
      <div><dt>DESIGNED</dt><dd>A specification or architecture decision exists; implementation is not implied.</dd></div>
      <div><dt>IMPLEMENTED</dt><dd>An identifiable implementation exists in the relevant repository.</dd></div>
      <div><dt>PROTOTYPE</dt><dd>A functional experiment exists, with limitations and non-production status disclosed.</dd></div>
      <div><dt>TESTED</dt><dd>Relevant tests have actually been executed and their results can be inspected.</dd></div>
      <div><dt>INTEGRATED</dt><dd>Functional integration with the relevant product or subsystem is demonstrated by evidence.</dd></div>
      <div><dt>VERIFIED</dt><dd>Explicit acceptance criteria have been satisfied; evidence states the tested scope, environment, date and limitations.</dd></div>
      <div><dt>BLOCKED</dt><dd>A concrete dependency prevents progress and is identified.</dd></div>
      <div><dt>NOT VERIFIED</dt><dd>Available evidence is insufficient to assign a stronger status.</dd></div>
    </dl>
  </section>
</ContentLayout>
