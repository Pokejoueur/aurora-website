---
import ContentLayout from "../../../layouts/ContentLayout.astro";
import status from "../../../data/status.json";
---
<ContentLayout title="Development" description="Aurora development status and verification information." eyebrow="DEVELOPMENT / STATUS" heading="Progress you can inspect." lead="Public progress records distinguish a working prototype from an implemented, tested or verified capability. Evidence and limitations remain visible.">
  <section class="section shell">
    <div class="status-table" role="table" aria-label="Public development status">
      <div class="status-row status-head" role="row"><span>WORKSTREAM</span><span>STATUS</span><span>LIMITATION</span></div>
      {status.entries.map((entry) => <div class="status-row" role="row"><strong>{entry.name}</strong><span class="status-label">{entry.status.toUpperCase()}</span><span>{entry.limitations}</span></div>)}
    </div>
    <p class="evidence-note">Last reviewed: {status.lastReviewed}. This registry is static and repository-maintained; it is not a live GitHub synchronization service.</p>
    <p><a class="text-link" href="https://github.com/Pokejoueur/aurora-website/blob/main/docs/development/roadmap.md">Read the implementation roadmap ↗</a></p>
  </section>
</ContentLayout>
