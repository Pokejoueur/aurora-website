---
import SiteLayout from "../../layouts/SiteLayout.astro";
import status from "../../data/status.json";
const projects = [
  { number: "01", name: "Aurora OS", type: "Operating system", description: "The operating-system workstream. Building independent computing foundations.", href: "/en/ecosystem/os/", status: "NOT VERIFIED", statusClass: "status-muted" },
  { number: "02", name: "Aurora Browser", type: "Web browser", description: "The browser workstream. Developing an independent browsing experience.", href: "/en/ecosystem/browser/", status: "NOT VERIFIED", statusClass: "status-muted" },
  { number: "03", name: "Aurora Website", type: "Public platform", description: "The public information and documentation platform connecting the ecosystem.", href: "/en/ecosystem/platform/", status: "PROTOTYPE", statusClass: "status-live" },
];
const principles = [
  { number: "01", title: "Privacy by default", description: "Minimize unnecessary data collection and make data handling understandable." },
  { number: "02", title: "Security by design", description: "Treat trust boundaries, isolation and least privilege as architectural concerns." },
  { number: "03", title: "Understandable systems", description: "Prefer technology whose behavior, limits and trade-offs can be inspected." },
  { number: "04", title: "User sovereignty", description: "Preserve meaningful user control over the computing environment." },
];
---
<SiteLayout title="Aurora — Independent computing. Built deliberately." description="Aurora is an independent computing ecosystem exploring a more deliberate, secure, understandable and user-controlled approach to computing.">
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> AN INDEPENDENT COMPUTING ECOSYSTEM</p>
      <h1>Build a better<br /><span>relationship with</span><br />your technology.</h1>
      <p class="hero-description">Aurora is an independent computing ecosystem exploring a more deliberate approach to technology — from the foundations of an operating system to the tools people use every day.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#ecosystem">Explore the ecosystem <span aria-hidden="true">↘</span></a>
        <a class="text-link" href="#engineering">Discover our engineering <span aria-hidden="true">↘</span></a>
      </div>
    </div>
    <div class="hero-visual">
      <img class="hero-logo" src="/aurora-logo.svg" alt="Aurora geometric emblem above a mountain horizon and northern lights." width="512" height="512" fetchpriority="high" />
      <span class="visual-coordinate">AURORA / SYSTEM IDENTITY 001</span>
    </div>
    <div class="hero-index"><span>01 / 03</span><span>ONE ECOSYSTEM · MULTIPLE WORKSTREAMS</span></div>
  </section>

  <section class="principle-strip" aria-label="Aurora philosophy">
    <div class="shell principle-strip-inner"><span>SECURITY BY DESIGN</span><span class="strip-separator" aria-hidden="true">✳</span><span>OPEN ENGINEERING</span><span class="strip-separator" aria-hidden="true">✳</span><span>MEASURED PROGRESS</span><span class="strip-separator" aria-hidden="true">✳</span><span>USER SOVEREIGNTY</span></div>
  </section>

  <section class="section shell" id="principles">
    <div class="section-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> PRINCIPLES / 01</p><h2>Technology should<br /><span>work for people.</span></h2></div><p class="section-intro">These principles guide the questions Aurora asks and the engineering trade-offs it documents. They are commitments in direction, not claims of completed product guarantees.</p></div>
    <div class="principle-grid">
      {principles.map((principle) => <article class="principle-card"><span>{principle.number}</span><h3>{principle.title}</h3><p>{principle.description}</p></article>)}
    </div>
  </section>

  <section class="section shell" id="ecosystem">
    <div class="section-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> THE ECOSYSTEM / 02</p><h2>One ecosystem.<br /><span>Distinct responsibilities.</span></h2></div><p class="section-intro">Three connected workstreams, each with a clear role. Public maturity labels are tied to the evidence currently published by this platform.</p></div>
    <div class="project-grid">
      {projects.map((project) => <article class="project-card"><div class="project-card-top"><span class="project-number">{project.number}</span><span class:list={["project-status", project.statusClass]}><span class="status-dot"></span>{project.status}</span></div><div class="project-card-body"><p class="project-type">{project.type}</p><h3>{project.name}</h3><p class="project-description">{project.description}</p></div><div class="project-card-bottom"><span><a class="text-link" href={project.href}>Explore workstream ↗</a></span></div></article>)}
    </div>
    <p class="evidence-note">“Not verified” means this website does not yet publish sufficient evidence to make a stronger claim. It does not mean that no development work exists.</p>
  </section>

  <section class="manifesto-section" id="engineering">
    <div class="shell manifesto-grid">
      <div><p class="eyebrow"><span class="eyebrow-line"></span> ENGINEERING / 03</p><h2>Ambition is easy.<br /><span>Engineering is proof.</span></h2></div>
      <div class="manifesto-content"><p class="manifesto-lead">A serious technical project must make its architecture, constraints and verification process understandable.</p>
        <div class="principle-list">
          <div class="principle-item"><span>01</span><div><h3>Architecture before claims</h3><p>Explain responsibilities, boundaries and trade-offs before presenting a feature as dependable.</p></div></div>
          <div class="principle-item"><span>02</span><div><h3>Security is structural</h3><p>Document trust boundaries, threat assumptions and known limitations instead of promising perfect security.</p></div></div>
          <div class="principle-item"><span>03</span><div><h3>Evidence is part of the product</h3><p>Connect public status to source changes, executed tests and explicit verification criteria.</p></div></div>
        </div>
        <a class="text-link" href="/en/engineering/">Explore engineering documentation ↗</a>
      </div>
    </div>
  </section>

  <section class="section shell" id="development">
    <div class="section-heading"><div><p class="eyebrow"><span class="eyebrow-line"></span> DEVELOPMENT / 04</p><h2>Progress you<br /><span>can inspect.</span></h2></div><p class="section-intro">The public status registry is maintained in this repository. It is static, reviewed during development sessions and never presented as live synchronization.</p></div>
    <div class="status-overview">
      {status.entries.map((entry) => <div class="status-overview-row"><strong>{entry.name}</strong><span class="status-label">{entry.status.toUpperCase()}</span><span>{entry.limitations}</span></div>)}
    </div>
    <p class="evidence-note">Last reviewed: {status.lastReviewed}. A successful website CI run does not establish product readiness or production deployment.</p>
    <a class="text-link" href="/en/development/">View roadmap and status records ↗</a>
  </section>

  <section class="documentation-band" id="documentation">
    <div class="shell documentation-band-inner"><div><p class="eyebrow"><span class="eyebrow-line"></span> DOCUMENTATION / 05</p><h2>Understand how<br /><span>Aurora works.</span></h2></div><div class="documentation-links"><a href="/en/ecosystem/">Explore Aurora <span>↗</span></a><a href="/en/docs/">Use Aurora <span>↗</span></a><a href="/en/engineering/">Develop Aurora <span>↗</span></a><p>Full documentation collections and search are planned. Unavailable guides are not represented as published content.</p></div></div>
  </section>

  <section class="section shell" id="community">
    <div class="community-panel"><div><p class="eyebrow"><span class="eyebrow-line"></span> COMMUNITY / 06</p><h2>Built openly.<br /><span>Improved deliberately.</span></h2><p class="section-intro">The website repository is the current verified public contribution entry point. Additional channels will appear only when configured.</p></div><a class="button button-primary" href="https://github.com/Pokejoueur/aurora-website" target="_blank" rel="noreferrer">Visit GitHub <span aria-hidden="true">↗</span></a></div>
  </section>
</SiteLayout>
