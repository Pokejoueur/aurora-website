---
import SiteLayout from "../../layouts/SiteLayout.astro";
import status from "../../data/status.json";
const osStatus = status.entries.find((entry) => entry.id === "aurora-os-public-evidence");
const browserStatus = status.entries.find((entry) => entry.id === "lumen-browser-public-evidence");
---
<SiteLayout title="Aurora — Independent computing. Built deliberately." description="Discover Aurora OS and Lumen, the Aurora Browser. Independent computing, built deliberately and documented with evidence.">
  <section class="home-cinema">
    <div class="shell">
      <div class="home-cinema-inner">
        <div class="home-cinema-copy">
          <p class="eyebrow"><span class="eyebrow-line"></span> AN INDEPENDENT COMPUTING ECOSYSTEM</p>
          <h1>Technology,<br />on a <span>different</span><br />horizon.</h1>
          <p class="home-cinema-description">A new foundation for personal computing. Built deliberately, from the system up.</p>
          <div class="home-cinema-actions">
            <a class="button button-primary" href="#ecosystem">Discover Aurora <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="https://github.com/Pokejoueur/aurora-website" target="_blank" rel="noreferrer">Source <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="home-cinema-art" aria-hidden="true">
          <div class="home-cinema-orbit"></div><div class="home-cinema-planet"></div>
          <span class="home-cinema-art-label">AURORA / INDEPENDENT COMPUTING</span>
        </div>
      </div>
      <div class="home-cinema-foot"><span>01 — A NEW COMPUTING ECOSYSTEM</span><span>OS / BROWSER / OPEN ENGINEERING</span></div>
    </div>
  </section>
  <section class="home-products-cinema shell" id="ecosystem" aria-label="Aurora products">
    <article class="home-cinema-product">
      <div class="home-cinema-product-copy">
        <p class="home-cinema-section-label">01 / OPERATING SYSTEM</p>
        <h2>Aurora <span>OS</span></h2>
        <p>A capability-based operating system, built from the ground up in Rust.</p>
        <div class="home-cinema-status"><i></i><span>IN DEVELOPMENT · PROJECT-REPORTED ESTIMATE: {osStatus?.reportedProgress ?? 70}%</span></div>
        <a class="home-cinema-link" href="/en/ecosystem/os/">EXPLORE AURORA OS <span>↗</span></a>
      </div>
      <div class="home-concept home-concept-os" role="img" aria-label="Conceptual visual representing Aurora OS, not a product screenshot">
        <div class="home-os-ring"></div><div class="home-os-horizon"></div><div class="home-os-core"><span>AU</span></div>
        <span class="home-concept-caption">CONCEPT VISUAL / NOT A PRODUCT SCREENSHOT</span>
      </div>
    </article>
    <article class="home-cinema-product">
      <div class="home-cinema-product-copy">
        <p class="home-cinema-section-label">02 / WEB BROWSER</p>
        <h2>Lumen</h2>
        <p>The Aurora Browser. A separate application, designed as part of the wider ecosystem.</p>
        <div class="home-cinema-status"><i></i><span>{browserStatus?.reportedStage?.toUpperCase() ?? "IN DEVELOPMENT"}</span></div>
        <a class="home-cinema-link" href="/en/ecosystem/browser/">EXPLORE LUMEN <span>↗</span></a>
      </div>
      <div class="home-concept home-concept-lumen" role="img" aria-label="Conceptual browser interface for Lumen, not a product screenshot">
        <div class="home-lumen-window">
          <div class="home-lumen-bar"><i></i><i></i><i></i><div class="home-lumen-address"></div></div>
          <div class="home-lumen-page"><small>LUMEN / BROWSER CONCEPT</small><strong>Clarity<br /><em>over noise.</em></strong></div>
        </div>
        <span class="home-concept-caption">CONCEPT VISUAL / NOT A PRODUCT SCREENSHOT</span>
      </div>
    </article>
  </section>
  <section class="home-cinema-end shell">
    <p>Independent engineering. Explicit design. Progress documented with evidence.</p>
    <a class="home-cinema-link" href="/en/docs/">EXPLORE THE PROJECT <span>↗</span></a>
  </section>
</SiteLayout>