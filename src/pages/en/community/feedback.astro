import ContentLayout from "../../../layouts/ContentLayout.astro";
---
<ContentLayout title="Aurora Feedback" description="How to provide feedback about Aurora Website." eyebrow="COMMUNITY / FEEDBACK" heading="Useful feedback is specific." lead="Report a reproducible problem, identify the affected page or component, and explain the expected result.">
<section class="section shell content-columns"><div><h2>Report a website issue</h2><p class="content-copy">Use the public GitHub issue tracker for broken links, incorrect content, accessibility problems or visual defects. Include your browser, viewport size and reproduction steps where relevant.</p><a class="button button-primary" href="https://github.com/Pokejoueur/aurora-website/issues">Open issue tracker ↗</a></div><div><h2>What to include</h2><ul class="content-list"><li>Page URL and timestamp.</li><li>Expected and actual behavior.</li><li>Steps to reproduce.</li><li>Browser and device details.</li><li>Screenshot or console output, with private data removed.</li></ul></div></section>
</ContentLayout>